# An Eval Project: evals kept apart from the resources they evaluate, so nothing
# in here can reach the agent. Run `skillgrade` from this directory.
#
#   eval-project.yml                 this file
#   skills/<name>/eval.yml           the eval of the skill <name>, with its graders/, llm_judges/ and workspace/
#
# Other resource kinds work the same way: agents/<name>/, instructions/<name>/, prompts/<name>/
# (declare where to find them under search_paths).

defaults:
  harness: gemini-cli    # gemini-cli | claude-code | codex | acp | opencode | command
  runtime: docker        # docker | local (use local for quick iteration)
  trials: 5              # number of independent runs per task
  timeout: 300           # seconds before the agent is killed
  threshold: 0.8         # minimum pass rate for --ci mode
  docker:
    base: node:20-slim   # base Docker image
    # setup: |           # extra setup commands (uncomment if needed)
    #   apt-get update && apt-get install -y <packages>

# Where each kind of resource is found, relative to this file. The kind of a
# resource is the key it is found under; its name is its directory's name.
search_paths:
  skills: {{SKILLS_PATHS}}
